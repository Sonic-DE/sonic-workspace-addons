#: ConfigEditJson.qml:24
msgid ""
"Edit the menu structure as JSON. Each item can have: name, icon, command "
"(run through the shell) or action (a session action: lock, logout, leave, "
"switchUser, suspend, hibernate, reboot, shutdown), submenu (array of items), "
"or separator (true)."
msgstr ""
"Uredite strukturo menija kot JSON. Vsak element ima lahko: name, icon, "
"command (zažene se prek lupine) ali action (dejanje seje: lock, logout, "
"leave, switchUser, suspend, hibernate, reboot, shutdown), submenu (polje "
"elementov) ali separator (true)."

